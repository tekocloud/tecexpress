{
  "name": "@tekocloud.de/tecexpress",
  "version": "0.6.0",
  "description": "Independent Vue 3 UI components with light and dark themes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tekocloud/tecexpress.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/tekocloud/tecexpress/tree/main/npm#readme",
  "bugs": {
    "url": "https://github.com/tekocloud/tecexpress/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "typescript",
    "components",
    "datagrid",
    "scheduler",
    "chat",
    "themes"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/tecexpress.js",
  "module": "./dist/tecexpress.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tecexpress.js"
    },
    "./themes/light.css": "./themes/light.css",
    "./themes/dark.css": "./themes/dark.css",
    "./themes/index.css": "./themes/index.css"
  },
  "files": [
    "dist",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "npm run build && vue-tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "build:demo": "npm run build && vite build --config demo/vite.config.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.0",
    "vue-tsc": "^3.1.0"
  }
}
