{
  "name": "tecexpress-workspace",
  "version": "0.4.0",
  "private": true,
  "workspaces": ["npm"],
  "scripts": {
    "dev": "npm run dev --workspace tecexpress",
    "build": "npm run build --workspace tecexpress",
    "typecheck": "npm run typecheck --workspace tecexpress",
    "test": "npm test --workspace tecexpress",
    "test:browser": "npm run test:browser --workspace tecexpress",
    "test:package": "npm run test:package --workspace tecexpress",
    "build:demo": "npm run build:demo --workspace tecexpress",
    "pack:npm": "npm pack --workspace tecexpress --pack-destination npm"
  }
}
